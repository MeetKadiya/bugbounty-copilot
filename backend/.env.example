# Copy this file to .env and fill in real values. Never commit .env to git.

ENV=development
DEBUG=true

HOST=0.0.0.0
PORT=8000
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]

DATABASE_URL=sqlite+aiosqlite:///./data/bugbounty.db

# Safety controls -- keep ALLOW_ACTIVE_RECON=false if you only want passive OSINT
ALLOW_ACTIVE_RECON=true
MAX_CONCURRENT_REQUESTS=20
REQUEST_TIMEOUT_SECONDS=10
RATE_LIMIT_PER_HOST_RPS=5.0

# AI analysis -- leave blank to use the built-in heuristic engine instead of Claude
ANTHROPIC_API_KEY=
AI_MODEL=claude-sonnet-4-6

LOG_LEVEL=INFO
